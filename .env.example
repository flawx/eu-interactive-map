NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
FIRMS_MAP_KEY=
METEOALARM_API_TOKEN=
TOMTOM_API_KEY=
ALERTS_DEMO_MODE=false

# Transit (server-side only — never expose to the browser)
GOOGLE_ROUTES_API_KEY=
# Optional European transit fallback (not dual-called by default)
NAVITIA_API_KEY=
# Flight offers (Amadeus Self-Service — Flight Offers Search / Price)
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
# test (default) or production
AMADEUS_ENV=test

